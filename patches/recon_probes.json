{
  "name": "HyperOS 6.x anchor discovery probes",
  "notes": "Used by tools/smali_recon.py to locate the real anchors of a camera build whose smali differs from patches/unlock_features.json (e.g. 6.1.000660.1).",
  "groups": [
    {
      "id": "assets_feature_config",
      "where": "assets",
      "description": "Feature gating config inside APK assets (zoom / fps / EIS / SAT / quality)",
      "probes": [
        {
          "id": "zoom_keys",
          "pattern": "zoom"
        },
        {
          "id": "fps_keys",
          "pattern": "60fps|fps"
        },
        {
          "id": "eis_keys",
          "pattern": "eis"
        },
        {
          "id": "sat_keys",
          "pattern": "sat|SAT"
        },
        {
          "id": "quality_keys",
          "pattern": "quality"
        },
        {
          "id": "bitrate_keys",
          "pattern": "bitrate"
        },
        {
          "id": "mfnr_keys",
          "pattern": "mfnr"
        },
        {
          "id": "heic_keys",
          "pattern": "heic"
        },
        {
          "id": "ultra_keys",
          "pattern": "ultrawide|ultra"
        },
        {
          "id": "watermark_keys",
          "pattern": "watermark"
        }
      ]
    },
    {
      "id": "opmode_60fps",
      "description": "60fps opmode freeze anchors",
      "probes": [
        {
          "id": "hsr60_context",
          "pattern": "HSR60"
        },
        {
          "id": "opmode_803c",
          "pattern": "0x803c"
        }
      ]
    }
  ]
}
