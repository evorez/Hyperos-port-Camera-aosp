<?xml version="1.0" encoding="utf-8"?>
<!--
  Allow HyperOS Modded Camera to access Android hidden APIs on Android 14-16 AOSP ROMs
  (e.g., SystemProperties, hidden CameraManager/CaptureRequest/Surface/Display APIs).
-->
<config>
    <hidden-api-whitelisted-app package="com.android.camera"/>
</config>
