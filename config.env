# ==============================================================================
# HYPEROS-CAM-AOSP Module Build Configuration
# ==============================================================================
# Edit these values to customize your generated Magisk / KernelSU / APatch ZIP.

MODULE_ID="hyperos_cam_aosp"
MODULE_NAME="Gold-Stock HyperOS Camera"
MODULE_AUTHOR="𝙴𝚟𝚘𝚛𝚎𝚣"
MODULE_DESCRIPTION="Gold-Stock HyperOS Camera by 𝙴𝚟𝚘𝚛𝚎𝚣 | Android 16 (API 36) AOSP port - Magisk/KernelSU/APatch flashable | https://t.me/evorezlabs"

# Module version metadata.
# "auto" = derive from MiuiCamera.apk versionName (Gold-Stock base reports 6.1.000660.1).
MODULE_VERSION="auto"
MODULE_VERSION_FALLBACK="-Universal Cam Evorez"
MODULE_VERSION_CODE="auto"
MODULE_VERSION_CODE_FALLBACK="10000"

# Supported Android API range (34 = Android 14, 35 = Android 15, 36 = Android 16)
MIN_ANDROID_API="34"
MAX_ANDROID_API="36"

# Optional updateJson URL for Magisk / KernelSU Manager in-app updates (leave empty if unused)
MODULE_UPDATE_JSON=""

# Native library extraction from APK into /system/priv-app/<App>/lib/arm64/
# Options:
#   auto   - Extract arm64-v8a/armeabi-v7a .so libs whenever present inside APK (recommended)
#   always - Always extract native libs
#   never  - Keep libs solely inside the APK (only safe if .so files are uncompressed & page-aligned)
EXTRACT_APK_LIBS="auto"

# Auto-merge all <uses-permission> entries found inside the APK's AndroidManifest.xml
# into privapp-permissions-*.xml to prevent Android 14-16 privapp-permissions bootloops.
AUTO_MERGE_PRIVAPP_PERMS="true"

# Conflicting AOSP stock camera replacement during install:
#   conflict_only - Only replace existing system camera folders matching the same package/folder (MiuiCamera)
#   replace_aosp  - Also replace stock AOSP Camera2 / Aperture / Snap alongside MiuiCamera
#   none          - Do not touch any existing camera packages
REPLACE_POLICY="conflict_only"

# Auto-grant runtime permissions on first boot via service.sh (CAMERA, RECORD_AUDIO, LOCATION, MEDIA)
AUTO_GRANT_PERMISSIONS="true"

# Output ZIP filename prefix (saved to dist/)
# Gold-Stock build: output will be dist/Gold-Stock-<version>-universal.zip
# Final delivery renamed to Gold-Stock.zip for easy flashing
OUTPUT_PREFIX="Gold-Stock"
